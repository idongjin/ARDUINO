int cds = A0;
int led = 3;
 
void setup() {
  Serial.begin(9600);          
  pinMode(led, OUTPUT);  
}
 
void loop() {
  int cdsValue = analogRead(cds);
 
  Serial.print("cds =  ");
  Serial.println(cdsValue);
 
  if (cdsValue > 500) {
    digitalWrite(led, HIGH);
    Serial.println("LED ON (cds > 500)");
  }
 
  else {
    digitalWrite(led, LOW);
    Serial.println("LED OFF (cds < 500)");
  }
  delay(200);
}
